<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  This file holds only the Info keys that Xcode's INFOPLIST_KEY_ build
	  setting mechanism cannot express. That mechanism recognises a fixed
	  allowlist of key names; anything outside it is silently ignored, with
	  no error and no warning.

	  Everything else - camera usage description, supported orientations,
	  launch screen, scene manifest - is still generated from build settings
	  by GENERATE_INFOPLIST_FILE, and the two are merged at build time.
	  Do not duplicate those keys here.
	-->

	<!--
	  Exposes the app's Documents directory in the Files app under
	  On My iPhone / On My iPad, which is how recorded clips get off the
	  device. AirDrop from Files copies the file byte for byte, so true
	  frame timing survives the transfer - unlike Photos, which retimes
	  high frame rate clips and would make every velocity wrong.
	-->
	<key>UIFileSharingEnabled</key>
	<true/>

	<!--
	  Declares the app as somewhere a movie can be sent, so AirDrop offers
	  GoalKick directly as a destination instead of forcing a detour through
	  the Files app.

	  That detour had a trap in it: iOS only lists an app's folder in Files
	  once the folder is non-empty, so on a device where GoalKick had never
	  recorded anything there was no GoalKick destination to save into, and
	  an AirDropped clip would land in Downloads - or worse, in Photos, which
	  retimes high frame rate video and silently ruins it for measurement.

	  Rank is Alternate, not Owner: GoalKick is one of several reasonable
	  places to send a .mov, not the system's idea of what a movie is for.
	-->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Video Clip</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.apple.quicktime-movie</string>
				<string>public.movie</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
